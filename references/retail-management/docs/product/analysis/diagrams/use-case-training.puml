@startuml
left to right direction
skinparam packageStyle rectangle

actor "Nhân viên mới/Người học" as Trainee
actor "Quản lý cửa hàng" as Manager

rectangle "Phân hệ hỗ trợ đào tạo" {
  usecase "Chọn kịch bản" as SelectScenario
  usecase "Thực hiện kịch bản" as RunScenario
  usecase "Khởi tạo dữ liệu\nphiên cách ly" as InitSandbox
  usecase "Nhận hướng dẫn" as Guidance
  usecase "Tương tác hàng hóa\nvà thiết bị" as Interact
  usecase "Thực hiện nghiệp vụ\nquản lý" as DoBusinessTask
  usecase "Ghi và đánh giá\nhành động" as Evaluate
  usecase "Nhận phản hồi" as Feedback
  usecase "Hoàn thành và\nxem kết quả" as Finish
  usecase "Xem kết quả\nđào tạo nhân viên" as ReviewResult
}

Trainee --> SelectScenario
Trainee --> RunScenario
Trainee --> Finish
Manager --> ReviewResult

RunScenario .> SelectScenario : <<include>>
RunScenario .> InitSandbox : <<include>>
RunScenario .> Guidance : <<include>>
RunScenario .> Interact : <<include>>
RunScenario .> DoBusinessTask : <<include>>
RunScenario .> Evaluate : <<include>>
Feedback .> Evaluate : <<extend>>
Finish .> Evaluate : <<include>>
@enduml
